{
  "name": "dahamkke-classroom",
  "version": "1.0.0",
  "private": true,
  "description": "Dahamkke Classroom - AI-based learning platform for multicultural students",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:domain": "npm run build --workspace=packages/domain",
    "build:shared": "npm run build --workspace=packages/shared",
    "typecheck": "tsc --noEmit --composite false"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
