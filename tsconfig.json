{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@dahamkke/shared": ["./packages/shared/src"],
      "@dahamkke/domain": ["./packages/domain/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".expo", ".next"]
}
